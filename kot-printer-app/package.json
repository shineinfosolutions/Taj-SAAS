{
  "name": "regalia-kot-printer-agent",
  "version": "1.0.0",
  "description": "Local tray agent that polls Taj Restaurant & Cafe for unprinted KOTs and sends them to a thermal printer (USB or Ethernet).",
  "main": "main.js",
  "author": "Taj Restaurant & Cafe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "rebuild-usb": "electron-rebuild -f -w @thiagoelg/node-printer",
    "dist": "electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "electron-store": "^8.2.0",
    "node-thermal-printer": "^4.4.4"
  },
  "optionalDependencies": {
    "@thiagoelg/node-printer": "^0.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "in.regalia.kotagent",
    "productName": "Taj Restaurant & Cafe KOT Printer",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "lib/**",
      "renderer/**",
      "assets/**"
    ],
    "asarUnpack": ["**/*.node", "**/@thiagoelg/**"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
